{
  "buildCommand": "node scripts/release.js",
  "outputDirectory": ".",
  "cleanUrls": false,
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(icons|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://*.supabase.co https://api.bigdatacloud.net https://nominatim.openstreetmap.org; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(?!(?:www|app|admin|api|mail|smtp|ftp|cdn|static|assets|dashboard|login|support|help|blog|docs|status|staging|test|dev|h|join|visit|pay|site|public|ns1|ns2)\\.)(?<slug>[a-z0-9][a-z0-9-]*)\\.sarvlekh\\.in$"
        }
      ],
      "destination": "/site.html?s=:slug"
    },
    {
      "source": "/api/public/:sub",
      "destination": "/api/public?sub=:sub"
    },
    {
      "source": "/h/:slug",
      "destination": "/site.html?s=:slug"
    }
  ],
  "crons": [
    {
      "path": "/api/admin?cron=sweep",
      "schedule": "30 21 * * *"
    }
  ]
}
