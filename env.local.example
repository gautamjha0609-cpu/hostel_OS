# Copy this file to  .env.local  (same folder as package.json) and fill in the values.
# .env.local is git-ignored. Never paste these into chat, code, or any file that is served.
#
# Supabase → Project Settings → API Keys → "service_role" (the SECRET one, not the publishable key).
# Needed for: set a password, create logins and clients, document clean-up (everything under /api/admin).
SUPABASE_SERVICE_ROLE_KEY=

# Optional ------------------------------------------------------------
# First-time super admin setup (any long random text; delete after use)
# SETUP_KEY=
# Protects the nightly clean-up route
# CRON_SECRET=
# Shared WhatsApp (Evolution API) server
# EVOLUTION_URL=https://
# EVOLUTION_API_KEY=

# Google Drive copy of the weekly backups (Usage -> Backups -> Connect Google Drive)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Redirect URI to allow:  http://localhost:5174/api/admin?oauth=callback   and   https://<your domain>/api/admin?oauth=callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Encrypts the files copied to Drive (any long text; keep it safe, the files cannot be opened without it)
# BACKUP_PASSPHRASE=

# STAGING (recommended for all local work) ------------------------------
# Point the whole local app at a separate test project instead of production. With both set,
# `npm run dev` rewrites js/config.js on the fly and scripts/restore.js writes there too.
# Use the STAGING project's service_role key above when you set these.
# SUPABASE_URL=https://<staging-ref>.supabase.co
# SUPABASE_ANON_KEY=
